// ================================================================
// Prisma Schema — PharmacyDB
// Sync với database Supabase (không để Prisma tạo migration)
// Dùng: prisma db pull (nếu muốn introspect từ DB có sẵn)
//        prisma generate (gen Prisma Client)
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Cần cho Supabase pooler
}

// ================================================================
// ENUMs
// ================================================================
enum MedicineStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK

  @@map("medicine_status")
}

enum ChangeTypeEnum {
  IMPORT
  EXPORT
  ADJUST

  @@map("change_type_enum")
}

enum OrderStatusEnum {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCEL_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURNED

  @@map("order_status_enum")
}

enum PaymentStatusEnum {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status_enum")
}

enum PaymentMethodEnum {
  COD
  VNPAY
  MOMO

  @@map("payment_method_enum")
}

enum TxnStatusEnum {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("txn_status_enum")
}

enum ShipmentStatusEnum {
  PENDING
  SHIPPING
  DELIVERED
  FAILED

  @@map("shipment_status_enum")
}

enum OtpPurposeEnum {
  REGISTER
  RESET_PASSWORD
  VERIFY_EMAIL
  VERIFY_PHONE

  @@map("otp_purpose_enum")
}

enum CouponTypeEnum {
  PERCENT
  FIXED

  @@map("coupon_type_enum")
}

// ================================================================
// MODELS
// ================================================================

model Role {
  roleId   BigInt @id @default(autoincrement()) @map("role_id")
  roleName String @unique @map("role_name") @db.VarChar(100)
  users    User[]

  @@map("roles")
}

model User {
  userId       BigInt    @id @default(autoincrement()) @map("user_id")
  userName     String    @unique @map("user_name") @db.VarChar(100)
  password     String    @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  phone        String    @unique @db.VarChar(20)
  avatar       String?   @db.VarChar(500)
  roleId       BigInt?   @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  isVerified   Boolean   @default(false) @map("is_verified")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastActivity DateTime? @map("last_activity")
  deletedAt    DateTime? @map("deleted_at")

  role          Role?          @relation(fields: [roleId], references: [roleId], onDelete: SetNull)
  refreshTokens RefreshToken[]
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  otps          Otp[]
  couponUsages  CouponUsage[]

  @@map("users")
}

model Address {
  addressId BigInt   @id @default(autoincrement()) @map("address_id")
  userId    BigInt   @map("user_id")
  receiver  String   @db.VarChar(255)
  phone     String   @db.VarChar(20)
  province  String   @db.VarChar(100)
  district  String   @db.VarChar(100)
  ward      String   @db.VarChar(100)
  street    String   @db.VarChar(500)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("addresses")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  token     String    @unique @db.VarChar(500)
  userId    BigInt    @map("user_id")
  expireAt  DateTime? @map("expire_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Otp {
  otpId     BigInt         @id @default(autoincrement()) @map("otp_id")
  userId    BigInt?        @map("user_id")
  email     String         @db.VarChar(255)
  code      String         @db.VarChar(10)
  purpose   OtpPurposeEnum
  isUsed    Boolean        @default(false) @map("is_used")
  expireAt  DateTime       @map("expire_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("otps")
}

model Category {
  categoryId BigInt     @id @default(autoincrement()) @map("category_id")
  parentId   BigInt?    @map("parent_id")
  name       String     @db.VarChar(255)
  slug       String     @unique @db.VarChar(255)
  icon       String?    @db.VarChar(500)
  sortOrder  Int        @default(0) @map("sort_order")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [categoryId], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  medicines Medicine[]

  @@map("categories")
}

model Manufacturer {
  manufacturerId BigInt     @id @default(autoincrement()) @map("manufacturer_id")
  name           String     @db.VarChar(255)
  country        String?    @db.VarChar(255)
  logo           String?    @db.VarChar(500)
  medicines      Medicine[]

  @@map("manufacturers")
}

model Medicine {
  medicineId           BigInt          @id @default(autoincrement()) @map("medicine_id")
  name                 String          @db.VarChar(500)
  slug                 String          @unique @db.VarChar(520)
  description          String?         @db.Text
  ingredients          String?         @db.Text
  usage                String?         @db.Text
  dosage               String?         @db.Text
  contraindication     String?         @db.Text
  price                Decimal         @db.Decimal(15, 2)
  originalPrice        Decimal?        @map("original_price") @db.Decimal(15, 2)
  unit                 String          @default("Hộp") @db.VarChar(50)
  requiresPrescription Boolean         @default(false) @map("requires_prescription")
  categoryId           BigInt?         @map("category_id")
  manufacturerId       BigInt?         @map("manufacturer_id")
  status               MedicineStatus  @default(ACTIVE)
  expireDate           DateTime?       @map("expire_date") @db.Date
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  deletedAt            DateTime?       @map("deleted_at")

  category     Category?       @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  manufacturer Manufacturer?   @relation(fields: [manufacturerId], references: [manufacturerId], onDelete: SetNull)
  images       MedicineImage[]
  inventory    Inventory?
  inventoryLogs InventoryLog[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlists    Wishlist[]

  @@map("medicines")
}

model MedicineImage {
  imageId    BigInt  @id @default(autoincrement()) @map("image_id")
  medicineId BigInt  @map("medicine_id")
  url        String  @db.VarChar(500)
  isPrimary  Boolean @default(false) @map("is_primary")
  sortOrder  Int     @default(0) @map("sort_order")

  medicine Medicine @relation(fields: [medicineId], references: [medicineId], onDelete: Cascade)

  @@map("medicine_images")
}

model Inventory {
  inventoryId BigInt   @id @default(autoincrement()) @map("inventory_id")
  medicineId  BigInt   @unique @map("medicine_id")
  quantity    Int      @default(0)
  lastUpdated DateTime @default(now()) @map("last_updated")

  medicine Medicine @relation(fields: [medicineId], references: [medicineId], onDelete: Cascade)

  @@map("inventory")
}

model InventoryLog {
  logId            BigInt         @id @default(autoincrement()) @map("log_id")
  medicineId       BigInt         @map("medicine_id")
  changeType       ChangeTypeEnum @map("change_type")
  quantity         Int
  previousQuantity Int            @map("previous_quantity")
  newQuantity      Int            @map("new_quantity")
  referenceId      BigInt?        @map("reference_id")
  note             String?        @db.VarChar(500)
  createdBy        BigInt?        @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")

  medicine Medicine @relation(fields: [medicineId], references: [medicineId], onDelete: Cascade)

  @@map("inventory_logs")
}

model Coupon {
  couponId       BigInt         @id @default(autoincrement()) @map("coupon_id")
  code           String         @unique @db.VarChar(50)
  name           String         @db.VarChar(255)
  description    String?        @db.Text
  type           CouponTypeEnum
  value          Decimal        @db.Decimal(15, 2)
  minOrderValue  Decimal        @default(0) @map("min_order_value") @db.Decimal(15, 2)
  maxDiscount    Decimal?       @map("max_discount") @db.Decimal(15, 2)
  usageLimit     Int?           @map("usage_limit")
  usedCount      Int            @default(0) @map("used_count")
  perUserLimit   Int            @default(1) @map("per_user_limit")
  isActive       Boolean        @default(true) @map("is_active")
  startAt        DateTime       @map("start_at")
  expireAt       DateTime       @map("expire_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  usageId   BigInt   @id @default(autoincrement()) @map("usage_id")
  couponId  BigInt   @map("coupon_id")
  userId    BigInt   @map("user_id")
  orderId   BigInt?  @map("order_id")
  usedAt    DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [couponId], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("coupon_usages")
}

model Cart {
  cartId    BigInt   @id @default(autoincrement()) @map("cart_id")
  userId    BigInt?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartItemId BigInt @id @default(autoincrement()) @map("cart_item_id")
  cartId     BigInt @map("cart_id")
  medicineId BigInt @map("medicine_id")
  quantity   Int    @default(1)

  cart     Cart     @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [medicineId], onDelete: Cascade)

  @@unique([cartId, medicineId], name: "uk_cart_medicine")
  @@map("cart_items")
}

model Order {
  orderId         BigInt            @id @default(autoincrement()) @map("order_id")
  userId          BigInt?           @map("user_id")
  orderCode       String            @unique @map("order_code") @db.VarChar(100)
  totalPrice      Decimal           @map("total_price") @db.Decimal(15, 2)
  originalPrice   Decimal           @map("original_price") @db.Decimal(15, 2)
  discountAmount  Decimal           @default(0) @map("discount_amount") @db.Decimal(15, 2)
  couponCode      String?           @map("coupon_code") @db.VarChar(50)
  paymentMethod   PaymentMethodEnum @default(COD) @map("payment_method")
  orderStatus     OrderStatusEnum   @default(PENDING) @map("order_status")
  paymentStatus   PaymentStatusEnum @default(PENDING) @map("payment_status")
  shippingAddress String?           @map("shipping_address") @db.VarChar(500)
  shippingFee     Decimal           @default(0) @map("shipping_fee") @db.Decimal(15, 2)
  note            String?           @db.Text
  cancelledBy     String?           @map("cancelled_by") @db.VarChar(20)
  cancelledReason String?           @map("cancelled_reason") @db.VarChar(500)
  cancelledAt     DateTime?         @map("cancelled_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user     User?       @relation(fields: [userId], references: [userId], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  shipment Shipment?

  @@map("orders")
}

model OrderItem {
  orderItemId  BigInt  @id @default(autoincrement()) @map("order_item_id")
  orderId      BigInt  @map("order_id")
  medicineId   BigInt? @map("medicine_id")
  medicineName String  @map("medicine_name") @db.VarChar(500)
  medicineUnit String  @map("medicine_unit") @db.VarChar(50)
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(15, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(15, 2)

  order    Order     @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  medicine Medicine? @relation(fields: [medicineId], references: [medicineId], onDelete: SetNull)

  @@map("order_items")
}

model Payment {
  paymentId       BigInt            @id @default(autoincrement()) @map("payment_id")
  orderId         BigInt            @map("order_id")
  paymentMethod   PaymentMethodEnum @map("payment_method")
  amount          Decimal           @db.Decimal(15, 2)
  transactionCode String?           @map("transaction_code") @db.VarChar(255)
  status          TxnStatusEnum     @default(PENDING)
  paidAt          DateTime?         @map("paid_at")
  expiredAt       DateTime?         @map("expired_at")
  rawCallback     Json?             @map("raw_callback")
  attemptCount    Int               @default(0) @map("attempt_count")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("payments")
}

model Shipment {
  shipmentId   BigInt              @id @default(autoincrement()) @map("shipment_id")
  orderId      BigInt              @unique @map("order_id")
  trackingCode String?             @map("tracking_code") @db.VarChar(100)
  carrier      String?             @db.VarChar(100)
  status       ShipmentStatusEnum? @default(PENDING)
  note         String?             @db.Text
  shippedAt    DateTime?           @map("shipped_at")
  deliveredAt  DateTime?           @map("delivered_at")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("shipments")
}

model Review {
  reviewId   BigInt   @id @default(autoincrement()) @map("review_id")
  userId     BigInt   @map("user_id")
  medicineId BigInt   @map("medicine_id")
  orderId    BigInt?  @map("order_id")
  rating     Int
  title      String?  @db.VarChar(255)
  content    String?  @db.Text
  isVerified Boolean  @default(false) @map("is_verified")
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [medicineId], onDelete: Cascade)

  @@unique([userId, medicineId], name: "uk_user_medicine_review")
  @@map("reviews")
}

model Wishlist {
  wishlistId BigInt   @id @default(autoincrement()) @map("wishlist_id")
  userId     BigInt   @map("user_id")
  medicineId BigInt   @map("medicine_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [medicineId], onDelete: Cascade)

  @@unique([userId, medicineId], name: "uk_wishlist")
  @@map("wishlists")
}
