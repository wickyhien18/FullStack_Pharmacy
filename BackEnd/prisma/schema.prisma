generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  roleId   BigInt @id @default(autoincrement()) @map("role_id")
  roleName String @unique @map("role_name") @db.VarChar(100)
  users    User[]

  @@map("roles")
}

model User {
  userId            BigInt             @id @default(autoincrement()) @map("user_id")
  userName          String             @unique @map("user_name") @db.VarChar(100)
  password          String             @db.VarChar(255)
  fullName          String             @map("full_name") @db.VarChar(255)
  email             String             @unique @db.VarChar(255)
  phone             String             @unique @db.VarChar(20)
  roleId            BigInt?            @map("role_id")
  isActive          Boolean?           @default(true) @map("is_active")
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  lastActivity      DateTime?          @map("last_activity") @db.Timestamp(6)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamp(6)
  cart              Cart[]
  orders            Order[]
  otpVerifications  OtpVerification?
  refreshTokens     RefreshToken[]
  role              Role?              @relation(fields: [roleId], references: [roleId], onUpdate: NoAction, map: "fk_user_role")

  @@map("users")
}

model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  token      String    @unique @db.VarChar(500)
  userId     BigInt    @map("user_id")
  expireAt   DateTime? @map("expire_at") @db.Timestamp(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  deviceInfo String?   @map("device_info") @db.VarChar(255)
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@map("refresh_tokens")
}

model Category {
  categoryId BigInt    @id @default(autoincrement()) @map("category_id")
  name       String    @db.VarChar(255)
  slug       String    @unique @db.VarChar(255)
  products   Product[]

  @@map("categories")
}

model Manufacturer {
  manufacturerId BigInt    @id @default(autoincrement()) @map("manufacturer_id")
  name           String    @db.VarChar(255)
  country        String?   @db.VarChar(255)
  products       Product[]

  @@map("manufacturers")
}

model Product {
  productId      BigInt         @id(map: "medicines_pkey") @default(autoincrement()) @map("product_id")
  name           String         @db.VarChar(500)
  slug           String         @unique(map: "medicines_slug_key") @db.VarChar(500)
  image          String?        @db.VarChar(500)
  description    String?
  price          Decimal        @db.Decimal(15, 2)
  unit           String?        @default("Hộp") @db.VarChar(50)
  categoryId     BigInt?        @map("category_id")
  manufacturerId BigInt?        @map("manufacturer_id")
  status         String?        @default("ACTIVE") @db.VarChar(255)
  expireDate     DateTime?      @map("expire_date") @db.Date
  createdAt      DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamp(6)
  cartItems      CartItem[]
  inventory      Inventory?
  inventoryLogs  InventoryLog[]
  orderItems     OrderItem[]
  images         ProductImage[]
  category       Category?      @relation(fields: [categoryId], references: [categoryId], onUpdate: NoAction, map: "medicines_category_id_fkey")
  manufacturer   Manufacturer?  @relation(fields: [manufacturerId], references: [manufacturerId], onUpdate: NoAction, map: "medicines_manufacturer_id_fkey")

  @@index([categoryId], map: "idx_products_category")
  @@index([manufacturerId], map: "idx_products_manufacturer")
  @@map("products")
}

model ProductImage {
  imageId      BigInt    @id(map: "medicine_images_pkey") @default(autoincrement()) @map("image_id")
  productId    BigInt    @map("product_id")
  imageUrl     String    @map("image_url") @db.VarChar(500)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  product      Product   @relation(fields: [productId], references: [productId], onDelete: Cascade, onUpdate: NoAction, map: "medicine_images_medicine_id_fkey")

  @@index([productId], map: "idx_product_images_product_id")
  @@map("product_images")
}

model Inventory {
  inventoryId BigInt    @id @default(autoincrement()) @map("inventory_id")
  productId   BigInt    @unique(map: "uk_inventory_medicine") @map("product_id")
  quantity    Int       @default(0)
  lastUpdated DateTime? @default(now()) @map("last_updated") @db.Timestamp(6)
  product     Product   @relation(fields: [productId], references: [productId], onDelete: Cascade, onUpdate: NoAction, map: "inventory_medicine_id_fkey")

  @@map("inventory")
}

model InventoryLog {
  logId            BigInt    @id @default(autoincrement()) @map("log_id")
  productId        BigInt    @map("product_id")
  changeType       String    @map("change_type") @db.VarChar(255)
  quantity         Int
  previousQuantity Int       @map("previous_quantity")
  newQuantity      Int       @map("new_quantity")
  referenceId      BigInt?   @map("reference_id")
  note             String?   @db.VarChar(500)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  product          Product   @relation(fields: [productId], references: [productId], onDelete: Cascade, onUpdate: NoAction, map: "inventory_logs_medicine_id_fkey")

  @@index([changeType], map: "idx_inventory_logs_type")
  @@index([productId], map: "idx_inventory_logs_product")
  @@map("inventory_logs")
}

model Cart {
  cartId    BigInt     @id @default(autoincrement()) @map("cart_id")
  userId    BigInt?    @map("user_id")
  createdAt DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  items     CartItem[]
  user      User?      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@map("carts")
}

model CartItem {
  cartItemId BigInt  @id @default(autoincrement()) @map("cart_item_id")
  cartId     BigInt  @map("cart_id")
  productId  BigInt  @map("product_id")
  quantity   Int     @default(1)
  cart       Cart    @relation(fields: [cartId], references: [cartId], onDelete: Cascade, onUpdate: NoAction)
  product    Product @relation(fields: [productId], references: [productId], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_medicine_id_fkey")

  @@unique([cartId, productId], name: "uk_cart_medicine", map: "uk_cart_medicine")
  @@map("cart_items")
}

model Order {
  orderId         BigInt      @id @default(autoincrement()) @map("order_id")
  userId          BigInt?     @map("user_id")
  orderCode       String      @unique @map("order_code") @db.VarChar(100)
  totalPrice      Decimal     @map("total_price") @db.Decimal(15, 2)
  orderStatus     String?     @default("PENDING") @map("order_status") @db.VarChar(255)
  paymentStatus   String?     @default("PENDING") @map("payment_status") @db.VarChar(255)
  shippingAddress String?     @map("shipping_address") @db.VarChar(500)
  note            String?
  cancelledBy     String?     @map("cancelled_by") @db.VarChar(20)
  cancelledReason String?     @map("cancelled_reason") @db.VarChar(500)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamp(6)
  createdAt       DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  items           OrderItem[]
  user            User?       @relation(fields: [userId], references: [userId], onUpdate: NoAction)
  payments        Payment[]
  shipment        Shipment[]

  @@index([orderStatus], map: "idx_orders_status")
  @@index([userId], map: "idx_orders_user")
  @@map("orders")
}

model OrderItem {
  orderItemId BigInt   @id @default(autoincrement()) @map("order_item_id")
  orderId     BigInt   @map("order_id")
  productId   BigInt?  @map("product_id")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(15, 2)
  product     Product? @relation(fields: [productId], references: [productId], onUpdate: NoAction, map: "order_items_medicine_id_fkey")
  order       Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "idx_order_items_order")
  @@map("order_items")
}

model Payment {
  paymentId       BigInt    @id @default(autoincrement()) @map("payment_id")
  orderId         BigInt    @map("order_id")
  paymentMethod   String    @map("payment_method") @db.VarChar(255)
  amount          Decimal   @db.Decimal(15, 2)
  transactionCode String?   @map("transaction_code") @db.VarChar(255)
  status          String?   @default("PENDING") @db.VarChar(255)
  paidAt          DateTime? @map("paid_at") @db.Timestamp(6)
  expiredAt       DateTime? @map("expired_at") @db.Timestamp(6)
  rawCallback     Json?     @map("raw_callback") @db.Json
  attemptCount    Int       @default(0) @map("attempt_count")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  order           Order     @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "idx_payments_order")
  @@index([status], map: "idx_payments_status")
  @@map("payments")
}

model Shipment {
  shipmentId   BigInt    @id @default(autoincrement()) @map("shipment_id")
  orderId      BigInt    @map("order_id")
  trackingCode String?   @map("tracking_code") @db.VarChar(100)
  carrier      String?   @db.VarChar(100)
  status       String?   @db.VarChar(255)
  shippedAt    DateTime? @map("shipped_at") @db.Timestamp(6)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamp(6)
  order        Order     @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)

  @@map("shipments")
}


model OtpVerification {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @unique @map("user_id")
  newEmail   String    @db.VarChar(255) @map("new_email")
  otp        String    @db.VarChar(10)
  expiresAt   DateTime  @db.Timestamp(6) @map("expires_at")
  createdAt  DateTime? @default(now()) @db.Timestamp(6) @map("created_at")
  users      User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@map("otp_verifications")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK

  @@map("product_status")
}

enum ChangeTypeEnum {
  IMPORT
  EXPORT
  ADJUST

  @@map("change_type_enum")
}

enum OrderStatusEnum {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCEL_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURNED

  @@map("order_status_enum")
}

enum PaymentStatusEnum {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status_enum")
}

enum PaymentMethodEnum {
  COD
  VNPAY
  MOMO

  @@map("payment_method_enum")
}

enum TxnStatusEnum {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("txn_status_enum")
}

enum ShipmentStatusEnum {
  PENDING
  SHIPPING
  DELIVERED
  FAILED

  @@map("shipment_status_enum")
}
